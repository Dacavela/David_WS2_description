<?xml version="1.0" ?>
<robot name="David_WS2" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find David_WS2_description)/urdf/materials.xacro" />
<xacro:include filename="$(find David_WS2_description)/urdf/David_WS2.ros2control.xml" />
<xacro:include filename="$(find David_WS2_description)/urdf/David_WS2.gazebo" />
<link name="base_link">
  <inertial>
    <origin xyz="-0.0008913252022397283 -1.720264503563007e-17 0.040307674387055174" rpy="0 0 0"/>
    <mass value="8.300506572251075"/>
    <inertia ixx="0.011487" iyy="0.027628" izz="0.0355" ixy="-0.0" iyz="-0.0" ixz="-2.1e-05"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find David_WS2_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find David_WS2_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="lidar_1">
  <inertial>
    <origin xyz="5.026061718855929e-18 0.0 0.0050000000000000044" rpy="0 0 0"/>
    <mass value="0.2219535209761188"/>
    <inertia ixx="5.2e-05" iyy="5.2e-05" izz="0.0001" ixy="0.0" iyz="-0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.0 -0.0 -0.0875" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find David_WS2_description)/meshes/lidar_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.0 -0.0 -0.0875" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find David_WS2_description)/meshes/lidar_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="camera_1">
  <inertial>
    <origin xyz="-0.019619262139605978 1.2740373127214816e-14 0.01001522954527926" rpy="0 0 0"/>
    <mass value="0.06477292024525207"/>
    <inertia ixx="4e-06" iyy="4e-06" izz="4e-06" ixy="-0.0" iyz="-0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.1 -0.0 -0.0575" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find David_WS2_description)/meshes/camera_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.1 -0.0 -0.0575" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find David_WS2_description)/meshes/camera_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="castor_1">
  <inertial>
    <origin xyz="-0.04000000000000029 4.5236341900007805e-17 -0.006391402495744495" rpy="0 0 0"/>
    <mass value="0.1627226693245905"/>
    <inertia ixx="2.2e-05" iyy="2.2e-05" izz="3.8e-05" ixy="-0.0" iyz="-0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.1 -0.0 -0.0175" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find David_WS2_description)/meshes/castor_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.1 -0.0 -0.0175" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find David_WS2_description)/meshes/castor_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="left_wheel_1">
  <inertial>
    <origin xyz="0.0 0.010000000000000023 6.938893903907228e-18" rpy="0 0 0"/>
    <mass value="0.6936047530503714"/>
    <inertia ixx="0.000267" iyy="0.000488" izz="0.000267" ixy="-0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.075 -0.08 -0.0375" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find David_WS2_description)/meshes/left_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0.01 0" rpy="1.5707963 0 0"/>
    <geometry>
      <cylinder radius="0.0375" length="0.02"/>
    </geometry>
  </collision>
</link>

<link name="right_wheel_1">
  <inertial>
    <origin xyz="0.0 -0.009999999999999995 6.938893903907228e-18" rpy="0 0 0"/>
    <mass value="0.6936047530503714"/>
    <inertia ixx="0.000267" iyy="0.000488" izz="0.000267" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.075 0.08 -0.0375" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find David_WS2_description)/meshes/right_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 -0.01 0" rpy="1.5707963 0 0"/>
    <geometry>
      <cylinder radius="0.0375" length="0.02"/>
    </geometry>
  </collision>
</link>

<joint name="lidarjoint" type="fixed">
  <origin xyz="0.0 0.0 0.0875" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="lidar_1"/>
</joint>

<joint name="camerajoint" type="fixed">
  <origin xyz="0.1 0.0 0.0575" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="camera_1"/>
</joint>

<joint name="casterjoint" type="fixed">
  <origin xyz="0.1 0.0 0.0175" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="castor_1"/>
</joint>

<!-- RUEDA IZQUIERDA -->
<joint name="left_joint" type="continuous">
  <origin xyz="-0.075 0.08 0.0375" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="left_wheel_1"/>
  <axis xyz="0 1 0"/>
</joint>

<!-- RUEDA DERECHA -->
<joint name="right_joint" type="continuous">
  <origin xyz="-0.075 -0.08 0.0375" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="right_wheel_1"/>
  <axis xyz="0 1 0"/>
</joint>

</robot>
